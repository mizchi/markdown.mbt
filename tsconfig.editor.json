{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "emitDeclarationOnly": false,
    "outDir": "dist/frontend",
    "rootDir": "frontend",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "frontend/editor/**/*.ts",
    "frontend/editor/**/*.tsx",
    "frontend/highlight/**/*.ts",
    "frontend/highlight/**/*.tsx"
  ],
  "exclude": [
    "frontend/**/*.test.ts",
    "frontend/**/*.test.tsx"
  ]
}
