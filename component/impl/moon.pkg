import {
  "markdown-component/gen/cabi",
  "mizchi/markdown",
  "mizchi/markdown/api",
}

options(
  "is-main": true,
  link: {
    "wasm": {
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportMdSerialize:mizchi:markdown/markdown@0.1.0#md-serialize",
        "wasmExportMdToAstJson:mizchi:markdown/markdown@0.1.0#md-to-ast-json",
        "wasmExportMdToHtml:mizchi:markdown/markdown@0.1.0#md-to-html",
      ],
      "export-memory-name": "memory",
    },
    "wasm-gc": {
      "exports": [
        "cabi_realloc:cabi_realloc",
        "wasmExportMdSerialize:mizchi:markdown/markdown@0.1.0#md-serialize",
        "wasmExportMdToAstJson:mizchi:markdown/markdown@0.1.0#md-to-ast-json",
        "wasmExportMdToHtml:mizchi:markdown/markdown@0.1.0#md-to-html",
      ],
      "export-memory-name": "memory",
    },
  },
)